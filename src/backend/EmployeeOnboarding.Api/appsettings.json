{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OnboardingDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Onboarding": {
    "RequiredDocumentTypes": [
      "PhotoIdentification",
      "RightToWork",
      "SignedContract",
      "BankDetails",
      "TaxDeclaration"
    ],
    "MaxUploadSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/jpg"
    ],
    "DefaultProvisioningSystems": [
      "Email Account",
      "Identity Directory Account",
      "Laptop",
      "VPN Access",
      "HR Self Service"
    ],
    "ReminderLeadDays": 2,
    "EscalationThresholdDays": 3,
    "LocalDocumentStorageRoot": "App_Data/documents",
    "BlobContainerName": "onboarding-documents"
  }
}
